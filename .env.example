# Existing application authentication
JWT_SECRET=replace-with-a-strong-secret

# Local development services. Leave the proxy entries blank when no proxy is used.
HTTP_PROXY=http://localhost:7897
HTTPS_PROXY=http://localhost:7897
GOOGLE_APPLICATION_CREDENTIALS=./flyer-genie.json

# KPay Online (UAT by default). Store only the base64 body from each KPay key file,
# without the -----BEGIN/END----- lines. Private key: PKCS#8 DER; public key: SPKI DER.
KPAY_MERCHANT_CODE=
KPAY_PRIVATE_KEY=
KPAY_PLATFORM_PUBLIC_KEY=

# Set only when KPay provisions the integration in service-provider mode.
KPAY_APP_ID=

# Change to https://payment.kpay-group.com only after KPay enables production.
KPAY_API_BASE_URL=https://payment.uat.kpay-group.com

# Required public app origin. Use the app's Heroku HTTPS domain, or its custom domain.
# Heroku runtime dyno metadata can provide the origin automatically when this is blank.
KPAY_PUBLIC_BASE_URL=