# Existing application authentication
JWT_SECRET=replace-with-a-strong-secret

# Local development services. Leave the proxy entries blank when no proxy is used.
HTTP_PROXY=http://localhost:7897
HTTPS_PROXY=http://localhost:7897
GOOGLE_APPLICATION_CREDENTIALS=./flyer-genie.json

# KPay Online (UAT by default). Use the PEM values from KPay's integration email.
# For multiline values in a platform environment variable, use literal \n escapes.
KPAY_MERCHANT_CODE=
KPAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
KPAY_PLATFORM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Set only when KPay provisions the integration in service-provider mode.
KPAY_APP_ID=

# Change to https://payment.kpay-group.com only after KPay enables production.
KPAY_API_BASE_URL=https://payment.uat.kpay-group.com

# These must be publicly reachable HTTPS URLs. notifyUrl cannot have a query string.
KPAY_NOTIFY_URL=https://api.example.com/api/payment/kpay/notify
KPAY_RETURN_URL=https://app.example.com/wallet